           model_type: 0                 #0=DEPTH_CAMERA (frustum model), 1=3D_LIDAR -- must be 0 for a depth camera
           obstacle_range: 3.0           #meters, D435 reliable indoor range
 
+      range_layer:   # the two sonars, via robot/sonar_range.py (2026-09-28)
+        plugin: "nav2_costmap_2d::RangeSensorLayer"
+        enabled: True
+        topics: ["/sonar/front", "/sonar/rear"]
+        input_sensor_type: VARIABLE
+        # A reading at max_range (4.0 - its no-echo 4.5 is sent as 4.0) clears
+        # the cone. That only turns UNKNOWN cells free, never camera
+        # obstacles, and lets a mark fade once the thing behind him leaves.
+        clear_on_max_reading: True
+        no_readings_timeout: 1.0
+        clear_threshold: 0.2
+        mark_threshold: 0.8
+        inflate_cone: 1.0
+      scan_layer:   # the lidar as a flat scan: the Orin's lidar-scan.service -> robot/lio_relay.py (2026-10-08)
+        plugin: "nav2_costmap_2d::ObstacleLayer"
+        enabled: True
+        observation_sources: scan
+        scan:
+          topic: /scan
+          data_type: "LaserScan"
+          marking: True
+          clearing: True
+          inf_is_valid: True            # a beam with no return clears along its whole length
+          # Short on purpose: the floor is only ~0.19 m under the scan's lower
+          # edge, and a pitching body tips far beams into it. Same as the camera.
+          obstacle_range: 3.0
+          raytrace_range: 3.5
+          # In the odom frame. Without it the limit is 0.0 and every point is thrown away.
+          max_obstacle_height: 2.0
       inflation_layer:
         plugin: "nav2_costmap_2d::InflationLayer"
