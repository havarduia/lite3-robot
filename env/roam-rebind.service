# Install on the perception computer (needs `sudo tailscale set --operator=ysc` once, here
# and on the motion computer, and ysc's key on the Orin: ssh-copy-id lite3@192.168.1.5):
#   sudo cp ~/robot/env/roam-rebind.service /etc/systemd/system/ && sudo systemctl enable --now roam-rebind
# When the Orin's wifi moves to another eduroam access point, the campus network drops our
# connections, but perception's and motion's own links (cable to the Orin) never change, so
# their Tailscale only notices its relay is dead ~60 s later. The rebind re-checks it within 3 s.
[Unit]
Description=Tailscale rebind when the Orin roams (README.md, remote driving)
After=tailscaled.service

[Service]
User=ysc
ExecStart=/bin/bash -c 'ssh -o BatchMode=yes -o ServerAliveInterval=5 -o ServerAliveCountMax=3 lite3@192.168.1.5 iw event | grep --line-buffered "wlP1p1s0.*connected to" | while read -r l; do echo "$$l"; tailscale debug rebind; ssh -o BatchMode=yes ysc@192.168.1.120 tailscale debug rebind; done'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
