# Install on the ORIN, the robot's eduroam client since 2026-10-19 (root):
#   sudo cp eduroam-watchdog.sh /usr/local/bin/ && sudo chmod +x /usr/local/bin/eduroam-watchdog.sh
#   sudo cp eduroam-watchdog.service /etc/systemd/system/ && sudo systemctl enable --now eduroam-watchdog
# Reconnects eduroam when its gateway stops answering, and roams to a stronger access
# point before the current one dies. The knobs (IF, EVERY, MISSES, ROAM_DBM, ROAM_GAIN,
# SCAN_EVERY) are at the top of eduroam-watchdog.sh; override them here with Environment=.
[Unit]
Description=Reconnect and roam eduroam on the Orin (lite3_api README.md)
After=NetworkManager.service

[Service]
ExecStart=/usr/local/bin/eduroam-watchdog.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
