<?xml version="1.0"?>
<package format="3">
  <name>lite3_terrain</name>
  <version>0.1.0</version>
  <description>FAST-LIO2's cloud and pose levelled for CMU terrainAnalysis, and its terrain map as heights for Nav2 (Lite3, on the Orin).</description>
  <maintainer email="haavardkso@gmail.com">Haavard Karlsen Solheim</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>eigen</depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
